# Bad Rally - web tĩnh (thư mục out/ của next build) + PocketBase (/api, /_)
# Tên miền lấy từ biến môi trường BADRALLY_DOMAIN (vd: badrally.tenmien.vn), mặc định là địa chỉ sslip.io hiện tại.
# Đặt bằng: sudo systemctl edit caddy → [Service] Environment=BADRALLY_DOMAIN=badrally.tenmien.vn — Caddy tự cấp HTTPS.
{$BADRALLY_DOMAIN:146-235-22-130.sslip.io} {
	encode zstd gzip

	# PocketBase: API + realtime (SSE) + trang quản trị /_/
	handle /api/* {
		reverse_proxy 127.0.0.1:8090
	}
	handle /_/* {
		reverse_proxy 127.0.0.1:8090
	}

	handle {
		root * /var/www/badrally
		header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
		header /*.html Cache-Control "no-cache"
		header /manifest.webmanifest Content-Type "application/manifest+json"
		try_files {path} {path}.html {path}/index.html /index.html
		file_server
	}
}
